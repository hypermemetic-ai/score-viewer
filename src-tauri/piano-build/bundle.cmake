file(GLOB_RECURSE archives "${ROOT}/library/lib/*.a" "${ROOT}/library/lib/*.lib")
list(SORT archives)
if(NOT archives)
  message(FATAL_ERROR "No sfizz archive closure was built")
endif()
get_filename_component(directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
file(REMOVE "${OUTPUT}")
if(MSVC_BUILD)
  execute_process(COMMAND "${AR}" /NOLOGO "/OUT:${OUTPUT}" ${archives} RESULT_VARIABLE result)
elseif(APPLE_BUILD)
  execute_process(COMMAND /usr/bin/libtool -static -o "${OUTPUT}" ${archives} RESULT_VARIABLE result)
else()
  # MRI ADDLIB combines complete archives, preserving duplicate object names.
  set(script "CREATE \"${OUTPUT}\"\n")
  foreach(archive IN LISTS archives)
    string(APPEND script "ADDLIB \"${archive}\"\n")
  endforeach()
  string(APPEND script "SAVE\nEND\n")
  file(WRITE "${directory}/bundle.mri" "${script}")
  execute_process(COMMAND "${AR}" -M INPUT_FILE "${directory}/bundle.mri" RESULT_VARIABLE result)
endif()
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Failed to combine sfizz archive closure: ${result}")
endif()
